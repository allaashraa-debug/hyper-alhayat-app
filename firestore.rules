rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category is string && data.category.size() > 0
        && (data.price is number && data.price >= 0)
        && data.weight is string
        && data.imageUrl is string
        && (!('isAvailable' in data) || data.isAvailable is bool);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.customerName is string && data.customerName.size() > 0
        && data.customerPhone is string && data.customerPhone.size() >= 8
        && data.customerAddress is string && data.customerAddress.size() > 0
        && data.paymentMethod is string && (data.paymentMethod in ['cash', 'card'])
        && data.status is string && (data.status in ['new', 'processing', 'delivery', 'completed', 'cancelled', 'archived'])
        && data.itemsJson is string
        && (data.subtotal is number && data.subtotal >= 0)
        && (data.deliveryFee is number && data.deliveryFee >= 0)
        && (data.grandTotal is number && data.grandTotal >= 0);
    }

    // Products catalog: anyone can read and manage products
    match /products/{productId} {
      allow read, write: if true;
    }

    function isValidStoreOrder(data) {
      return data.customerName is string && data.customerName.size() > 0
        && data.customerPhone is string && data.customerPhone.size() >= 8
        && data.customerAddress is string && data.customerAddress.size() > 0
        && data.status is string
        && data.itemsJson is string
        && (data.grandTotal is number && data.grandTotal >= 0);
    }

    // Store Admin Orders: Global collection for incoming purchase orders
    match /store_orders/{orderId} {
      allow create: if isValidStoreOrder(request.resource.data);
      allow read, update: if true;
      allow delete: if isAuthenticated();
    }

    // Customer Orders: isolated by user ID
    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOrder(request.resource.data);
      allow update: if isOwner(userId) && isValidOrder(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Store settings (e.g., store open/closed status)
    match /store_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
