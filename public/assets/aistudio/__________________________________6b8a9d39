function buildWhatsAppOrderMessage(order) { let msg = 🛒 *طلب جديد من متجر هايبر الحياة*\n; msg += 📄 *رقم الفاتورة:* ${order.id}\n; msg += 👤 *العميل:* ${order.customerName}\n; msg += 📞 *الهاتف:* ${order.customerPhone}\n; msg += 📍 *العنوان:* ${order.customerAddress}\n; msg += 💳 *طريقة الدفع:* ${order.payment === 'cash' ? 'كاش عند الاستلام' : 'بطاقة ائتمان'}\n\n; msg += 🛍️ *المنتجات المطلوبة:*\n; order.items.forEach((item, index) => { msg += ${index + 1}. {item.weight}) × ${item.qty} = ${(item.price * item.qty).toFixed(2)} ج.م\n; }); msg += \n💵 *الإجمالي الكلي:* ${order.grandTotal.toFixed(2)} ج.م; return msg; }
